{
  "name": "erp-reporting-data-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Data and report tests for a sample ERP database: reconciliation against source data, boundary cases and a seeded-defect check.",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "db:reset": "tsx scripts/reset-db.ts",
    "test": "vitest run",
    "test:defects": "tsx scripts/defect-check.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "decimal.js": "^10.4.3",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
